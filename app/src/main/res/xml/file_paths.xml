<?xml version="1.0" encoding="utf-8"?>
<!--
    file_paths.xml - FileProvider path declarations for SugarDaddi
    ===============================================================

    Referenced from AndroidManifest.xml:
        <provider android:name="androidx.core.content.FileProvider"
                  android:authorities="li.masciul.sugardaddi.fileprovider"
                  android:resource="@xml/file_paths" ... />

    WHAT THIS DOES
    ==============
    FileProvider translates File objects into content:// URIs that can be safely
    shared with other apps (camera, gallery). Each <external-files-path> entry
    declares a path under getExternalFilesDir() that the provider may serve.

    <external-files-path> maps to Context.getExternalFilesDir(null) - correct
    for app-private external storage. No READ/WRITE_EXTERNAL_STORAGE needed (API 29+).

    WHY EACH DIRECTORY IS DECLARED
    ================================
    FileProvider rejects URIs for any path not declared here with a SecurityException.
    The camera app writes into the URI we provide - it must cover the target directory.
    We declare each subdirectory explicitly rather than using path="." to follow the
    principle of least privilege.

    DIRECTORY STRUCTURE (mirrors ImageStorageManager constants exactly)
    ===================================================================
    getExternalFilesDir(null)/
    └── sugardaddi/
        ├── thumbnails/    ← auto-cached remote thumbnails (never gallery-scanned)
        ├── products/      ← hero images for food products
        ├── recipes/       ← hero images for recipes
        ├── meals/         ← meal journal photos
        └── steps/         ← recipe step instructional photos
-->
<paths>

    <!--
        Thumbnails - auto-cached remote images.
        Declared so thumbnails can be shared with external viewers if needed.
        The camera does NOT write here; ImageDownloader manages this directory.
    -->
    <external-files-path
        name="sugardaddi_thumbnails"
        path="sugardaddi/thumbnails/" />

    <!--
        Products - hero images for food products.
        The camera writes a new UUID-named file here when the user attaches
        or replaces a hero image for a food product.
    -->
    <external-files-path
        name="sugardaddi_products"
        path="sugardaddi/products/" />

    <!--
        Recipes - hero images for recipes.
        The camera writes here for recipe hero image capture/replacement.
    -->
    <external-files-path
        name="sugardaddi_recipes"
        path="sugardaddi/recipes/" />

    <!--
        Meals - photos attached to meal journal entries.
        The camera writes here when the user photos a meal.
    -->
    <external-files-path
        name="sugardaddi_meals"
        path="sugardaddi/meals/" />

    <!--
        Steps - instructional photos for recipe preparation steps.
        The camera writes here when the user captures a step result photo.
    -->
    <external-files-path
        name="sugardaddi_steps"
        path="sugardaddi/steps/" />

</paths>