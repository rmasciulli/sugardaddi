<?xml version="1.0" encoding="utf-8"?>
<!--
    nutrition_label_header.xml — Column header for DETAILED mode (3 columns).

    TYPOGRAPHY:
      textAppearanceLabelMedium (12sp, medium weight) for all header columns.
      Header labels should be smaller/lighter than the data rows below them —
      LabelMedium is the correct token for table column headings.

    DARK MODE:
      Background uses ?attr/colorSurface (resolves to surface_dark in night).
      Text uses ?attr/colorOnSurface.
      Divider uses ?attr/colorOnSurface at 20% alpha.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- Column headers row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <!-- Column 1: Nutrient name header -->
        <TextView
            android:id="@+id/headerNutrient"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold"
            android:paddingEnd="8dp"
            android:text="@string/nutrition_label_nutrient_column" />

        <!-- Column 2: Per 100g — EU mandatory column, always visible.
             autoSizeTextType adapts if the unit string "pour 100ml" is long. -->
        <TextView
            android:id="@+id/headerPer100g"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="12sp"
            android:autoSizeStepGranularity="1sp"
            android:gravity="end"
            android:paddingEnd="8dp"
            android:text="@string/per_100g" />

        <!-- Column 3: Custom amount — updated dynamically by NutritionLabelManager -->
        <TextView
            android:id="@+id/headerCustomAmount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="12sp"
            android:autoSizeStepGranularity="1sp"
            android:gravity="end"
            android:text="@string/per_20g" />

    </LinearLayout>

    <!-- Separator line: full-opacity primary color marks the boundary between
         header and data rows — visually anchors the table. -->
    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOnSurface" />

</LinearLayout>