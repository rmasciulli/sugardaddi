<?xml version="1.0" encoding="utf-8"?>
<!--
    nutrition_label_header.xml - Column titles for DETAILED mode (3 columns).

    TYPOGRAPHY:
      Title role (res/values/nutrition_text.xml, 14sp bold), one line each.
      The custom amount title ("per 20g") is in ?attr/colorPrimary, like the
      values of its column; the per-100 title stays in colorOnSurface.

    WIDTHS: columns 2 and 3 are as wide as the widest title or value of the
    table, set by NutritionLabelManager.applyColumnWidths() on every build, so
    "per 100ml" never wraps and the columns line up with the rows below.
    Separated by @dimen/nutrition_column_gap, like the values. The end padding
    matches the rows' (6dp).
    For prepared values, NutritionLabelManager adds a caption above this row
    ("Values for the prepared product"): the column titles stay short.

    DARK MODE:
      No background: the table box (bg_nutrition_block) shows through.
      Divider uses ?attr/colorOnSurface.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <!-- Column 1: Nutrient name title, takes the remaining width -->
        <TextView
            android:id="@+id/headerNutrient"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.SugarDaddi.Nutrition.Title"
            android:textColor="?attr/colorOnSurface"
            android:text="@string/nutrition_label_nutrient_column" />

        <!-- Column 2: per 100g / 100ml (EU mandatory column) -->
        <TextView
            android:id="@+id/headerPer100g"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.SugarDaddi.Nutrition.Title"
            android:textColor="?attr/colorOnSurface"
            android:text="@string/per_100g" />

        <!-- Column 3: custom amount, updated by NutritionLabelManager -->
        <TextView
            android:id="@+id/headerCustomAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/nutrition_column_gap"
            android:gravity="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.SugarDaddi.Nutrition.Title"
            android:textColor="?attr/colorPrimary"
            android:text="@string/per_20g" />

    </LinearLayout>

    <!-- Separator line: full-opacity colour marks the boundary between
         header and data rows - visually anchors the table. -->
    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOnSurface" />

</LinearLayout>
