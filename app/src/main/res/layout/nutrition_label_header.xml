<?xml version="1.0" encoding="utf-8"?>
<!--
    nutrition_label_header.xml - Column header for DETAILED mode (3 columns).

    TYPOGRAPHY:
      Title role (res/values/nutrition_text.xml, bold) for all header columns;
      columns 2 and 3 auto-size down to the Minimum role.
      For prepared values, NutritionLabelManager adds a caption above this row
      ("Values for the prepared product"): the column titles stay short.

    DARK MODE:
      No background: the table box (bg_nutrition_block) shows through.
      Text uses ?attr/colorOnSurface.
      Divider uses ?attr/colorOnSurface at 20% alpha.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Column headers row. center_vertical: when a column title takes two lines
         (long units, larger font settings), the others sit on its middle. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <!-- Column 1: Nutrient name header -->
        <TextView
            android:id="@+id/headerNutrient"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:textAppearance="@style/TextAppearance.SugarDaddi.Nutrition.Title"
            android:textColor="?attr/colorOnSurface"
            android:paddingEnd="8dp"
            android:text="@string/nutrition_label_nutrient_column" />

        <!-- Column 2: Per 100g - EU mandatory column, always visible.
             autoSizeTextType adapts if the unit string "pour 100ml" is long.
             Two lines allowed, so a long title wraps instead of being clipped. -->
        <TextView
            android:id="@+id/headerPer100g"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.SugarDaddi.Nutrition.Title"
            android:textColor="?attr/colorOnSurface"
            android:maxLines="2"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="@dimen/nutrition_text_min"
            android:autoSizeMaxTextSize="@dimen/nutrition_text_title"
            android:autoSizeStepGranularity="1sp"
            android:gravity="end"
            android:paddingEnd="8dp"
            android:text="@string/per_100g" />

        <!-- Column 3: Custom amount - updated dynamically by NutritionLabelManager -->
        <TextView
            android:id="@+id/headerCustomAmount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.SugarDaddi.Nutrition.Title"
            android:textColor="?attr/colorOnSurface"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="@dimen/nutrition_text_min"
            android:autoSizeMaxTextSize="@dimen/nutrition_text_title"
            android:autoSizeStepGranularity="1sp"
            android:gravity="end"
            android:text="@string/per_20g" />

    </LinearLayout>

    <!-- Separator line: full-opacity primary color marks the boundary between
         header and data rows - visually anchors the table. -->
    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOnSurface" />

</LinearLayout>