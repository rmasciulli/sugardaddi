<?xml version="1.0" encoding="utf-8"?>
<!--
    item_search_recipe_default.xml
    Generic (fallback) search result card for recipes.

    Used by DefaultRecipeSearchDelegate, the LAST-registered recipe delegate: it
    renders recipes from any source without a dedicated delegate (and any future
    user-created recipes). Source-specific delegates (MealDbRecipeSearchDelegate ->
    item_search_recipe_themealdb.xml, CocktailDbRecipeSearchDelegate ->
    item_search_recipe_cocktaildb.xml) take precedence; this is the safe default.

    STRUCTURE:
    [Recipe name (bold, 2 lines)]
    ──────────────────────────────────────────────
    [72x72]  Description (optional)
    [thumb]  25 min . 4 servings . Easy

    Optional thumbnail strategy - identical to item_search_product_ciqual/usda:
    the image container is GONE by default; bindImage() makes it VISIBLE only when
    a thumbnail source resolves (user override, auto-cached path, or remote URL).
    Recipes with no resolvable image collapse the slot cleanly.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- ROW 1: Recipe name + source badge - mirrors item_search_product_default.xml's
             dynamic sourceBadge (any source, unlike the dedicated MealDB/CocktailDB
             layouts which hardcode a static string, since those are single-source). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/recipeName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text="Grilled Salmon with Lemon Butter" />

            <TextView
                android:id="@+id/sourceBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorSecondary"
                android:background="@drawable/rounded_corner_8dp"
                android:backgroundTint="?attr/colorPrimary"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="FatSecret" />

        </LinearLayout>

        <!-- ROW 2: optional image (GONE by default) + content column -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <include layout="@layout/thumbnail_72dp" />

            <!-- Content column: description + (time / servings / difficulty) row.
                 match_parent + the Space before the metadata row let it align
                 to the thumbnail's bottom edge when content is short - see
                 item_search_product_default.xml for the full rationale.
                 gravity="center_vertical" removed: it would center the whole
                 block instead of anchoring top content to the top. -->
            <LinearLayout
                android:id="@+id/detailsColumn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="72dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Description (truncated) -->
                <TextView
                    android:id="@+id/recipeDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:text="A simple and healthy recipe for perfectly grilled salmon" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginBottom="2dp"
                    android:layout_weight="1" />

                <!-- Metadata Row: Time | Servings | Difficulty -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Time -->
                    <TextView
                        android:id="@+id/recipeTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone"
                        tools:visibility="visible"
                        tools:text="25 min" />

                    <!-- Separator - visibility toggled in bindSeparators(), not static -->
                    <View
                        android:id="@+id/separator1"
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:layout_marginHorizontal="8dp"
                        android:background="?attr/colorOnSurfaceVariant"
                        android:visibility="gone" />

                    <!-- Servings -->
                    <TextView
                        android:id="@+id/recipeServings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone"
                        tools:visibility="visible"
                        tools:text="4 servings" />

                    <!-- Separator - visibility toggled in bindSeparators(), not static -->
                    <View
                        android:id="@+id/separator2"
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:layout_marginHorizontal="8dp"
                        android:background="?attr/colorOnSurfaceVariant"
                        android:visibility="gone" />

                    <!-- Difficulty -->
                    <TextView
                        android:id="@+id/recipeDifficulty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textColor="?attr/colorPrimary"
                        android:visibility="gone"
                        tools:visibility="visible"
                        tools:text="Easy" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>