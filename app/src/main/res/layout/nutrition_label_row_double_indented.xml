<?xml version="1.0" encoding="utf-8"?>
<!--
    nutrition_label_row_double_indented.xml - Double-indented row (indent level 2).
    Examples: ALA, EPA, DHA (sub-nutrients of Omega-3).

    TYPOGRAPHY:
      Nutrient name: textAppearanceLabelSmall (11sp medium) - deepest hierarchy,
      smallest text. Still uses colorOnSurfaceVariant to remain readable without
      fighting the higher-level rows for attention.
      Values: autoSize 10–12sp.

    INDENTATION: paddingStart="32dp" signals second level of nesting.

    DARK MODE: ?attr/colorSurface background.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:gravity="center_vertical"
        android:minHeight="28dp">

        <!-- Column 1: Nutrient name - 32dp indent for second nesting level -->
        <TextView
            android:id="@+id/nutrientName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:paddingStart="32dp"
            android:paddingEnd="8dp"
            android:text="    DHA" />

        <!-- Column 2: Per 100g value -->
        <TextView
            android:id="@+id/valuePer100g"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="12sp"
            android:autoSizeStepGranularity="1sp"
            android:gravity="end"
            android:paddingEnd="8dp"
            android:text="0 mg" />

        <!-- Column 3: Custom amount value -->
        <TextView
            android:id="@+id/valueCustomAmount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="12sp"
            android:autoSizeStepGranularity="1sp"
            android:gravity="end"
            android:text="0 mg" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="8dp"
        android:background="?attr/colorOnSurface"
        android:alpha="0.1" />

</LinearLayout>