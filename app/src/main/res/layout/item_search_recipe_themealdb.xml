<?xml version="1.0" encoding="utf-8"?>
<!--
    item_search_recipe_themealdb.xml
    Search result card for TheMealDB recipes.

    STRUCTURE:
    ┌───────────────────────────────────────────────────┐
    │ [Recipe name (bold, 2 lines)]   [TheMealDB badge] │
    │ Recipe                                            │
    │ ───────────────────────────────────────────────── │
    │ [72x72     ]  Japanese · Chicken                  │
    │ [thumbnail ]  8 ingredients        ▶ Video        │
    │ [          ]  [Meat] [Casserole]                  │
    └───────────────────────────────────────────────────┘

    Notes:
    - Ingredient count and video indicator on the same line
    - Tag chips on the third metadata line (below ingredient row)
    - Chips are compact — Widget.Material3.Chip.Filter style
    - Video indicator only shown when strYoutube is set
    - Tags ChipGroup hidden when no displayable tags

    Used by: MealDbRecipeSearchDelegate
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- ROW 1: Recipe name + source badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">

            <TextView
                android:id="@+id/recipeName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Chocolate Gateau" />

            <TextView
                android:id="@+id/sourceBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorPrimary"
                android:background="@drawable/rounded_corner_8dp"
                android:backgroundTint="?attr/colorPrimaryContainer"
                android:text="@string/recipe_source_themealdb" />

        </LinearLayout>

        <!-- ROW 2: productType label ("Recipe") -->
        <TextView
            android:id="@+id/productType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:text="@string/product_type_recipe"
            android:visibility="visible" />

        <!-- ROW 3: thumbnail + metadata column -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Thumbnail: 72x72dp — identical to OFF cards -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/imageContainer"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginEnd="10dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant">

                <ImageView
                    android:id="@+id/recipeImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/colorSurfaceVariant"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/product_image_description"
                    tools:src="@drawable/ic_food_placeholder" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Metadata column: description, ingredient+video row, chips -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <!-- Area · Category e.g. "Japanese · Chicken" -->
                <TextView
                    android:id="@+id/recipeDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:text="Japanese · Chicken" />

                <!-- Ingredient count -->
                <TextView
                    android:id="@+id/ingredientCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:text="8 ingredients" />

                <!-- Tag chips — compact, on the third metadata line -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/tagsChipGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="0dp"
                    app:chipSpacingHorizontal="4dp"
                    app:singleLine="true"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <!-- Chips added programmatically by MealDbRecipeSearchDelegate -->
                    <include layout="@layout/chip_tag_compact" />

                </com.google.android.material.chip.ChipGroup>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>