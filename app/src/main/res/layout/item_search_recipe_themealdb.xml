<?xml version="1.0" encoding="utf-8"?>
<!--
    item_search_recipe_themealdb.xml
    Search result card for TheMealDB recipes.

    STRUCTURE:
    ┌───────────────────────────────────────────────────┐
    │ [Recipe name (bold, 2 lines)]   [TheMealDB badge] │
    │ Recipe                                            │
    │ ───────────────────────────────────────────────── │
    │ [72x72     ]  Japanese · Chicken                  │
    │ [thumbnail ]  8 ingredients                       │
    │ [          ]  [Meat] [Casserole]                  │
    └───────────────────────────────────────────────────┘

    Notes:
    - Ingredient count and video indicator on the same line
    - Tag chips on the third metadata line (below ingredient row)
    - Chips are compact - Widget.Material3.Chip.Filter style
    - Video indicator only shown when strYoutube is set
    - Tags ChipGroup hidden when no displayable tags

    Used by: MealDbRecipeSearchDelegate
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- ROW 1: Recipe name + source badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">

            <TextView
                android:id="@+id/mealQuantityBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSecondaryContainer"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="231g - " />

            <TextView
                android:id="@+id/recipeName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Chocolate Gateau" />

            <TextView
                android:id="@+id/sourceBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorPrimary"
                android:background="@drawable/rounded_corner_8dp"
                android:backgroundTint="?attr/colorPrimaryContainer"
                android:text="@string/recipe_source_themealdb" />

            <ImageView
                android:id="@+id/navigateChevron"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:padding="2dp"
                android:src="@drawable/ic_chevron_right"
                android:contentDescription="@string/view_details"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

        <!-- ROW 2: productType label ("Recipe") -->
        <TextView
            android:id="@+id/productType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:text="@string/product_type_recipe"
            android:visibility="visible" />

        <!-- ROW 3: thumbnail + metadata column -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <include layout="@layout/thumbnail_72dp" />

            <!-- Metadata column: description, ingredient+video row, chips.
                 match_parent + the Space before the chip row let it align to
                 the thumbnail's bottom edge when content is short - see
                 item_search_product_default.xml for the full rationale.
                 gravity="center_vertical" removed: it would center the whole
                 block instead of anchoring top content to the top. -->
            <LinearLayout
                android:id="@+id/detailsColumn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="72dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Area · Category e.g. "Japanese · Chicken" -->
                <TextView
                    android:id="@+id/recipeDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:text="Japanese · Chicken" />

                <!-- Ingredient count -->
                <TextView
                    android:id="@+id/ingredientCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:text="8 ingredients" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginBottom="2dp"
                    android:layout_weight="1" />

                <!-- Tag chips - horizontal RecyclerView, real native
                     scrolling. See TagChipAdapter's Javadoc for why this
                     replaced ChipGroup + HorizontalScrollView. -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/tagsChipGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clipToPadding="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:listitem="@layout/chip_tag_compact" />

            </LinearLayout>

        </LinearLayout>

        <include layout="@layout/expandable_nutrition_detail" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>