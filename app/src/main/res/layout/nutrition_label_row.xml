<?xml version="1.0" encoding="utf-8"?>
<!--
    nutrition_label_row.xml - Standard nutrient row (indent level 0).

    TYPOGRAPHY:
      Nutrient name: textAppearanceBodyMedium (14sp regular) - primary read target.
      Values: autoSize 12-14sp base textAppearanceBodySmall - adapt to column width.
      colorOnSurface for the name (full emphasis), colorOnSurfaceVariant for values
      (secondary, slightly dimmed to draw eye to the name column first).

    DARK MODE:
      Background ?attr/colorSurface. Divider ?attr/colorOnSurface at 10% alpha.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:gravity="center_vertical"
        android:minHeight="36dp">

        <!-- Column 1: Nutrient name - no indentation at level 0 -->
        <TextView
            android:id="@+id/nutrientName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurface"
            android:paddingEnd="8dp"
            android:text="Nutrient" />

        <!-- Column 2: Per 100g value - autoSize keeps alignment when values are long -->
        <TextView
            android:id="@+id/valuePer100g"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeMaxTextSize="14sp"
            android:autoSizeStepGranularity="1sp"
            android:gravity="end"
            android:paddingEnd="8dp"
            android:text="0 g" />

        <!-- Column 3: Custom amount value -->
        <TextView
            android:id="@+id/valueCustomAmount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeMaxTextSize="14sp"
            android:autoSizeStepGranularity="1sp"
            android:gravity="end"
            android:text="0 g" />

    </LinearLayout>

    <!-- Row divider - light separator, not a strong line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:background="?attr/colorOnSurface"
        android:alpha="0.1" />

</LinearLayout>