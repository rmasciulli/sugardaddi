<?xml version="1.0" encoding="utf-8"?>
<!--
    item_search_product_ciqual.xml
    Search result card for Ciqual (ANSES) scientific database entries.

    STRUCTURE:
    [Product name]                         [Ciqual badge]
    Food product                           <- subtitle, always below title
    ─────────────────────────────────────────────────────
    Chocolate and chocolate products
    58.0g carbohydrates per 100g           492 kcal

    No image (scientific reference data, no product photos).
    No NutriScore / EcoScore (Ciqual has no scoring system).

    Used by: CiqualProductSearchDelegate
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- ROW 1: product name + Ciqual badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">

            <TextView
                android:id="@+id/productName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Chocolate bar with biscuit, with caramel filling" />

            <!-- Secondary container to distinguish from OFF's primary container badge -->
            <TextView
                android:id="@+id/sourceBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorSecondary"
                android:background="@drawable/rounded_corner_8dp"
                android:backgroundTint="?attr/colorPrimary"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="Ciqual" />

        </LinearLayout>

        <!-- ROW 2: productType subtitle ("Food product").
             Identical position and style as OFF layout. -->
        <TextView
            android:id="@+id/productType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="Food product" />

        <!-- ROW 3: optional image (GONE by default) + content column -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!--
                User-defined image — shown only when the user has explicitly set
                one via ImagePickerHelper. GONE by default; bindImage() makes it
                VISIBLE when userThumbnailPath or userImagePath is non-null.
                Ciqual has no remote image URL and no auto-downloaded thumbnail.
            -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/imageContainer"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginEnd="12dp"
                android:visibility="gone"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant">

                <ImageView
                    android:id="@+id/productImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/product_image_description"
                    android:scaleType="centerCrop"
                    tools:src="@drawable/ic_food_placeholder" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Content column: category + nutrition row -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <!-- Category (primary metadata for Ciqual entries) -->
                <TextView
                    android:id="@+id/category"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:fontFamily="@font/roboto_condensed"
                    android:fontWeight="300"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:text="Dairy products › dairy desserts" />

                <!-- Nutrition row: carbs left, kcal badge right -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/nutritionSummary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/roboto_condensed"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:visibility="gone"
                        tools:visibility="visible"
                        tools:text="20.3g carbohydrates per 100g" />

                    <TextView
                        android:id="@+id/kcalBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:paddingHorizontal="7dp"
                        android:paddingVertical="2dp"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary"
                        android:background="@drawable/rounded_corner_8dp"
                        android:backgroundTint="?attr/colorTertiaryContainer"
                        android:visibility="gone"
                        tools:visibility="visible"
                        tools:text="155 kcal" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>