<?xml version="1.0" encoding="utf-8"?>
<!--
    item_search_product_ciqual.xml
    Search result card for Ciqual (ANSES) scientific database entries.

    STRUCTURE:
    [Product name]                         [Ciqual badge]
    Food product                           <- subtitle, always below title
    ─────────────────────────────────────────────────────
    Chocolate and chocolate products
    58.0g carbohydrates per 100g           492 kcal

    No remote image (scientific reference data, no product photos) - but
    can still show a user-set custom thumbnail, same as every other card.
    No NutriScore / EcoScore (Ciqual has no scoring system).

    Used by: CiqualProductSearchDelegate
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- ROW 1: product name + Ciqual badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">

            <TextView
                android:id="@+id/mealQuantityBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSecondaryContainer"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="231g - " />

            <TextView
                android:id="@+id/productName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Chocolate bar with biscuit, with caramel filling" />

            <!-- Secondary container to distinguish from OFF's primary container badge -->
            <TextView
                android:id="@+id/sourceBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorSecondary"
                android:background="@drawable/rounded_corner_8dp"
                android:backgroundTint="?attr/colorPrimary"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="Ciqual" />

            <ImageView
                android:id="@+id/navigateChevron"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:padding="2dp"
                android:src="@drawable/ic_chevron_right"
                android:contentDescription="@string/view_details"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

        <!-- ROW 2: productType subtitle ("Food product").
             Identical position and style as OFF layout. -->
        <TextView
            android:id="@+id/productType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="Food product" />

        <!-- ROW 3: optional image (GONE by default) + content column -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <include layout="@layout/thumbnail_72dp" />

            <!-- Content column: category + nutrition row. match_parent height
                 + the Space below the category line let the nutrition row
                 align to the thumbnail's bottom edge when content is short,
                 without forcing anything when it's not - see
                 item_search_product_default.xml for the full rationale.
                 gravity="center_vertical" is deliberately removed here: it
                 would fight this top+bottom anchoring by centering the whole
                 content block as a group instead. -->
            <LinearLayout
                android:id="@+id/detailsColumn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="72dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Category (primary metadata for Ciqual entries) -->
                <TextView
                    android:id="@+id/categories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:fontFamily="@font/roboto_condensed"
                    android:fontWeight="300"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:text="Dairy products › dairy desserts" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginBottom="2dp"
                    android:layout_weight="1" />

                <!-- Nutrition row: carbs left, kcal badge right -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/nutritionSummary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="@font/roboto_condensed"
                        android:maxLines="1"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone"
                        tools:text="20.3g carbohydrates per 100g"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/kcalBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/rounded_corner_8dp"
                        android:backgroundTint="?attr/colorTertiaryContainer"
                        android:paddingHorizontal="7dp"
                        android:paddingVertical="2dp"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textColor="?attr/colorPrimary"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:text="155 kcal"
                        tools:visibility="visible" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <include layout="@layout/expandable_nutrition_detail" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>