<?xml version="1.0" encoding="utf-8"?>
<!--
    view_quantity_input.xml - content of QuantityInputView ("Measurements & quantity").

    Merged into QuantityInputView, which IS the MaterialCardView: the card's own
    margins, corner radius and elevation are set where the view is placed, like
    every other card of the detail layouts.

    STRUCTURE:
      [<]  ViewFlipper (one slide visible)  [>]
           slide 1 - SERVINGS: title, typical serving size, servings with - / +
           slide 2 - CUSTOM:   title, typical serving size, quantity typed on the
                               numpad with the item's unit shown right after it
      dots (built in code, one per slide)

    SYMMETRY: the card has the same padding on both sides and both arrows have
    the same 40dp gutter, kept even when an arrow is hidden (INVISIBLE in code),
    so the slide content sits exactly in the middle on every page. Slides have
    no padding of their own.

    The title is part of each slide, so it moves with the slide and lines up
    with the rows below it.

    ICON BUTTONS: every icon-only button sets its padding, insets and icon
    gravity explicitly. The Material defaults are made for 48dp buttons with
    insets; in a 40dp box they push the icon off centre.

    The ViewFlipper sizes itself to its taller slide (measureAllChildren), so the
    card never jumps or clips when switching slides, whatever the font scale.
-->
<merge
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="com.google.android.material.card.MaterialCardView">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Previous slide - same chevron as next, mirrored -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/quantityPrevious"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="8dp"
                android:rotation="180"
                android:contentDescription="@string/quantity_previous"
                app:icon="@drawable/ic_chevron_right"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="24dp"
                app:iconTint="?attr/colorPrimary" />

            <ViewFlipper
                android:id="@+id/quantityFlipper"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:measureAllChildren="true">

                <!-- ~~~~~~~~ SLIDE 1 - SERVINGS ~~~~~~~~ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/quantity_card_title"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/quantity_typical_serving"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/servingsTypicalValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            tools:text="30 g" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:minHeight="28dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/quantity_servings"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/servingsValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="?attr/colorOnSurface"
                            android:textStyle="bold"
                            tools:text="3,5 (105 g)" />

                        <!-- 28dp rounded squares: outlined button, no insets, icon centred.
                             Below the 48dp touch-target guideline: a deliberate
                             trade-off for a compact card. -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/servingsMinus"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            android:contentDescription="@string/quantity_decrease"
                            app:cornerRadius="6dp"
                            app:icon="@drawable/ic_remove"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconSize="16dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/servingsPlus"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginStart="6dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            android:contentDescription="@string/quantity_increase"
                            app:cornerRadius="6dp"
                            app:icon="@drawable/ic_add"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconSize="16dp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- ~~~~~~~~ SLIDE 2 - CUSTOM QUANTITY ~~~~~~~~ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/quantity_card_title"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/quantity_typical_serving"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/customTypicalValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            tools:text="30 g" />

                    </LinearLayout>

                    <!-- Tapping anywhere on the row focuses the field (set in code) -->
                    <LinearLayout
                        android:id="@+id/customQuantityRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:minHeight="28dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/quantity_custom"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurface" />

                        <!-- Plain number, no box: it reads like the servings value.
                             FIXED width, end-aligned, so the number always ends
                             right before the unit. Not wrap_content: a one-line
                             EditText scrolls its text sideways, and when its width
                             changes with the text (a value filled in from the
                             servings slide) that scroll is not reset, so the
                             number can end up drawn outside the field.
                             The key listener is set in code so both "." and ","
                             are accepted whatever the keyboard. -->
                        <EditText
                            android:id="@+id/customQuantityInput"
                            android:layout_width="88dp"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:gravity="end|center_vertical"
                            android:imeOptions="actionDone"
                            android:importantForAutofill="no"
                            android:inputType="numberDecimal"
                            android:maxLength="7"
                            android:selectAllOnFocus="true"
                            android:hint="@string/quantity_custom_hint"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="?attr/colorOnSurface"
                            android:textStyle="bold"
                            tools:text="105" />

                        <!-- The item's unit, appended automatically -->
                        <TextView
                            android:id="@+id/customUnitLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="?attr/colorOnSurface"
                            android:textStyle="bold"
                            tools:text="g" />

                    </LinearLayout>

                </LinearLayout>

            </ViewFlipper>

            <!-- Next slide -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/quantityNext"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="8dp"
                android:contentDescription="@string/quantity_next"
                app:icon="@drawable/ic_chevron_right"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="24dp"
                app:iconTint="?attr/colorPrimary" />

        </LinearLayout>

        <!-- One dot per slide, built in QuantityInputView.buildDots() -->
        <LinearLayout
            android:id="@+id/quantityDots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal" />

    </LinearLayout>

</merge>
