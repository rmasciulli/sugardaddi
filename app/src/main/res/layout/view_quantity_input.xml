<?xml version="1.0" encoding="utf-8"?>
<!--
    view_quantity_input.xml - content of QuantityInputView.

    Merged into QuantityInputView, a vertical LinearLayout drawing the same
    box as the nutrition table (bg_nutrition_block: white, square corners,
    thin grey border). It sits in the "Nutrition Facts" section of a detail card, which
    provides the section title and the margins.

    STRUCTURE:
      SwipePagerView (one page visible, swiped with the finger)
        page 1 - "Number of servings": typical serving size, servings with - / +
        page 2 - "Portion size": typical serving size, quantity typed on the
                 numpad with the item's unit shown right after it
        page 3 - "Measurements & quantity": the preferred unit, g | ml, one tap
                 switches; disabled, with a line saying why, when the item
                 can only be shown in one unit (no density from its source)
      PagerDotsView (one tappable dot per page)

    Pages carry their own 12dp side padding, so while swiping their content
    slides right up to the edge instead of vanishing inside the box.
    SPACING: 10dp above the title, 12dp on the sides; below, the dots' touch
    area (8dp under the dot) plus a 5dp margin, so the gap under the dots reads
    like the other three sides.
    The pager is as tall as its tallest page: the box never changes height.
    VALUES: the typical serving value uses the same size as the value under it
    (BodyLarge), regular weight and primary color: bold stays for the amount
    that gets logged. Every row ends with a 28dp outlined button in the same
    column (+ on page 1, pencils elsewhere), so the values line up. Icons:
    primary blue for the typical serving pencil (it edits the item), dark
    (quantity_icon_on_surface) for - / + and the quantity pencil (they edit
    the amount being logged).

    ICON BUTTONS: padding, insets and icon gravity are set explicitly. The
    Material defaults are made for 48dp buttons with insets and push the icon
    off centre in a small box. 28dp is below the 48dp touch guideline: accepted
    for a compact input.
-->
<merge
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout"
    tools:orientation="vertical">

    <li.masciul.sugardaddi.ui.components.SwipePagerView
        android:id="@+id/quantityPager"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- ~~~~~~~~ PAGE 1 - NUMBER OF SERVINGS ~~~~~~~~ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/quantity_page_servings"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <!-- Typical serving: the pencil button edits it (QuantityInputView
                 reports the tap, the screen opens TypicalServingDialog). The
                 whole row also answers the tap, for a larger target; only the
                 button shows a ripple. -->
            <LinearLayout
                android:id="@+id/servingsTypicalRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:minHeight="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/quantity_typical_serving"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/servingsTypicalValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/colorPrimary"
                    tools:text="30 g" />

                <!-- Same 28dp outlined square as - / +, in the + column -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/servingsTypicalEdit"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:contentDescription="@string/quantity_edit_typical"
                    app:cornerRadius="6dp"
                    app:icon="@drawable/ic_edit"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="16dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/quantity_servings"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/servingsValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold"
                    tools:text="3,5 (105 g)" />

                <!-- 28dp rounded squares: outlined button, no insets, icon centred -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/servingsMinus"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:contentDescription="@string/quantity_decrease"
                    app:cornerRadius="6dp"
                    app:icon="@drawable/ic_remove"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="16dp"
                    app:iconTint="@color/quantity_icon_on_surface" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/servingsPlus"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="6dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:contentDescription="@string/quantity_increase"
                    app:cornerRadius="6dp"
                    app:icon="@drawable/ic_add"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="16dp"
                    app:iconTint="@color/quantity_icon_on_surface" />

            </LinearLayout>

        </LinearLayout>

        <!-- ~~~~~~~~ PAGE 2 - PORTION SIZE ~~~~~~~~ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/quantity_page_portion"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <!-- Typical serving: the pencil button edits it (QuantityInputView
                 reports the tap, the screen opens TypicalServingDialog). The
                 whole row also answers the tap, for a larger target; only the
                 button shows a ripple. -->
            <LinearLayout
                android:id="@+id/customTypicalRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:minHeight="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/quantity_typical_serving"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/customTypicalValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/colorPrimary"
                    tools:text="30 g" />

                <!-- Same 28dp outlined square as - / +, in the + column -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/customTypicalEdit"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:contentDescription="@string/quantity_edit_typical"
                    app:cornerRadius="6dp"
                    app:icon="@drawable/ic_edit"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="16dp" />

            </LinearLayout>

            <!-- Tapping anywhere on the row focuses the field (set in code) -->
            <LinearLayout
                android:id="@+id/customQuantityRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/quantity_custom"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurface" />

                <!-- Plain number, no box: it reads like the servings value.
                     FIXED width, end-aligned, so the number always ends right
                     before the unit. Not wrap_content: a one-line EditText
                     scrolls its text sideways, and when its width changes with
                     the text that scroll is not reset.
                     saveEnabled false: QuantityInputView saves and restores the
                     value itself; an automatic restore would count as typing.
                     The key listener is set in code so both "." and "," are
                     accepted whatever the keyboard. -->
                <EditText
                    android:id="@+id/customQuantityInput"
                    android:layout_width="88dp"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:gravity="end|center_vertical"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:maxLength="7"
                    android:saveEnabled="false"
                    android:selectAllOnFocus="true"
                    android:hint="@string/quantity_custom_hint"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold"
                    tools:text="105" />

                <!-- The input's unit, appended automatically. Same 8dp gap before
                     the button as the values above, so "75 g" ends where
                     "30 g" ends. -->
                <TextView
                    android:id="@+id/customUnitLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="8dp"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold"
                    tools:text="g" />

                <!-- Pencil in the + column, dark icon: edits the amount being
                     logged (focuses the field), unlike the blue one above,
                     which edits the item's typical serving. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/customQuantityEdit"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:contentDescription="@string/quantity_edit_custom"
                    app:cornerRadius="6dp"
                    app:icon="@drawable/ic_edit"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="16dp"
                    app:iconTint="@color/quantity_icon_on_surface" />

            </LinearLayout>

        </LinearLayout>

        <!-- ~~~~~~~~ PAGE 3 - MEASUREMENTS & QUANTITY ~~~~~~~~ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/quantity_page_units"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:minHeight="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/unitLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/quantity_preferred_unit"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurface" />

                <!-- Segmented g | ml: one tap on the other segment switches.
                     selectionRequired: one unit is always selected. The labels
                     are the units' abbreviations, set in code. Disabled (both
                     segments) when the item has only one unit. -->
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/unitToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/unitG"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="52dp"
                        android:layout_height="32dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        tools:text="g" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/unitMl"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="52dp"
                        android:layout_height="32dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        tools:text="ml" />

                </com.google.android.material.button.MaterialButtonToggleGroup>

            </LinearLayout>

            <!-- Shown only when the toggle is disabled: why it cannot change -->
            <TextView
                android:id="@+id/unitOnlyNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                tools:text="@string/quantity_unit_only_g"
                tools:visibility="visible" />

        </LinearLayout>

    </li.masciul.sugardaddi.ui.components.SwipePagerView>

    <!-- One tappable dot per page; attached to the pager in code -->
    <li.masciul.sugardaddi.ui.components.PagerDotsView
        android:id="@+id/quantityDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="5dp" />

</merge>
