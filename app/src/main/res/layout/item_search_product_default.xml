<?xml version="1.0" encoding="utf-8"?>
<!--
    item_search_product_default.xml
    Fallback search result card for products from sources without a dedicated
    delegate: USDA, USER, CUSTOM, IMPORTED, or null source.

    STRUCTURE:
    [Product name]                         [Source badge]
    Food product                           <- subtitle, always below title
    ─────────────────────────────────────────────────────
    [72x72 image]  Brand name
                   Category description
                   100 g

    Mirrors OFF layout exactly, minus the score stack.
    productType subtitle is in the same position as OFF and Ciqual.

    Used by: DefaultProductSearchDelegate
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- ROW 1: product name + source badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">

            <TextView
                android:id="@+id/mealQuantityBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSecondaryContainer"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="231g - " />

            <TextView
                android:id="@+id/productName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Generic Food Product Name" />

            <TextView
                android:id="@+id/sourceBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorSecondary"
                android:background="@drawable/rounded_corner_8dp"
                android:backgroundTint="?attr/colorPrimary"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="USDA" />

            <ImageView
                android:id="@+id/navigateChevron"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:padding="2dp"
                android:src="@drawable/ic_chevron_right"
                android:contentDescription="@string/view_details"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

        <!-- ROW 2: productType subtitle ("Food product" or "Recipe").
             Identical position and style as OFF and Ciqual layouts. -->
        <TextView
            android:id="@+id/productType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="Food product" />

        <!-- ROW 3: image + details (no score stack for default source) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <include layout="@layout/thumbnail_72dp" />

            <!-- Details column: fills remaining width AND stretches to match
                 the thumbnail's height (match_parent) - the Space below needs
                 real height to absorb. Top content (brand/category) stays
                 naturally top-anchored; the flexible Space pushes only the
                 nutrition row down to the thumbnail's bottom edge. Collapses
                 to zero when there's no thumbnail, or when content is taller
                 than 72dp anyway - nothing here forces a fixed height that
                 could clip longer content. -->
            <LinearLayout
                android:id="@+id/detailsColumn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="72dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Brand: Inter semi-bold, primary color -->
                <TextView
                    android:id="@+id/brandName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:fontFamily="@font/inter"
                    android:fontWeight="600"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorPrimary"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:text="Brand Name" />

                <!-- Category: Roboto Condensed light, 2 lines, sentence case -->
                <TextView
                    android:id="@+id/categories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:fontFamily="@font/roboto_condensed"
                    android:fontWeight="300"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:text="Dairy products › dairy desserts" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginBottom="2dp"
                    android:layout_weight="1" />

                <!-- Nutrition row: carbs left, kcal badge right - same convention
                     as item_search_product_ciqual/usda.xml. Carbs lead because
                     this is a glycemic-tracking app; kcal is secondary. Row is
                     GONE entirely when there's no nutrition at all (e.g. every
                     FatSecret search result - see FatSecretMapper's own
                     comment: search results carry no structured nutrition). -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/nutritionSummary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/roboto_condensed"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:visibility="gone"
                        tools:visibility="visible"
                        tools:text="20.3g carbohydrates per 100g" />

                    <TextView
                        android:id="@+id/kcalBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:paddingHorizontal="7dp"
                        android:paddingVertical="2dp"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary"
                        android:background="@drawable/rounded_corner_8dp"
                        android:backgroundTint="?attr/colorTertiaryContainer"
                        android:visibility="gone"
                        tools:visibility="visible"
                        tools:text="180 kcal" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <include layout="@layout/expandable_nutrition_detail" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>