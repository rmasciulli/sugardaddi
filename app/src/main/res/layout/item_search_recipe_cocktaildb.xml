<?xml version="1.0" encoding="utf-8"?>
<!--
    item_search_recipe_cocktaildb.xml
    Search result card for TheCocktailDB cocktails.

    STRUCTURE:
    ┌───────────────────────────────────────────────────────┐
    │ [Cocktail name (bold, 2 lines)]  [TheCocktailDB badge]│
    │ Cocktail                                              │
    │ ───────────────────────────────────────────────────── │
    │ [72x72     ]  Cocktail · Alcoholic                    │
    │ [thumbnail ]  5 ingredients                           │
    │ [          ]  [IBA] [NewEra]                          │
    └───────────────────────────────────────────────────────┘

    Mirrors item_search_recipe_themealdb.xml exactly in structure.
    Only the badge text and source differ - same ViewHolder field IDs.

    Used by: CocktailDbRecipeSearchDelegate
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- ROW 1: Cocktail name + source badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">

            <TextView
                android:id="@+id/recipeName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Margarita" />

            <TextView
                android:id="@+id/sourceBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorPrimary"
                android:background="@drawable/rounded_corner_8dp"
                android:backgroundTint="?attr/colorPrimaryContainer"
                android:text="@string/source_name_thecocktaildb" />

        </LinearLayout>

        <!-- ROW 2: productType label ("Cocktail" or "Cocktail · Video") -->
        <TextView
            android:id="@+id/productType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:text="@string/product_type_cocktail"
            android:visibility="visible" />

        <!-- ROW 3: thumbnail + metadata column -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Thumbnail: 72x72dp - identical to MealDB card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/imageContainer"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginEnd="10dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant">

                <ImageView
                    android:id="@+id/recipeImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/colorSurfaceVariant"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/product_image_description"
                    tools:src="@drawable/ic_food_placeholder" />

                <ImageView
                    android:id="@+id/cardExpandIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_expand_icon_scrim_sm"
                    android:padding="3dp"
                    android:src="@drawable/ic_fullscreen"
                    android:scaleType="fitCenter"
                    android:visibility="gone"
                    android:importantForAccessibility="no" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Metadata column: description, ingredient count, tags -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <!-- Category · Alcoholic status e.g. "Cocktail · Alcoholic" -->
                <TextView
                    android:id="@+id/recipeDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:text="Cocktail · Alcoholic" />

                <!-- Ingredient count -->
                <TextView
                    android:id="@+id/ingredientCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:text="5 ingredients" />

                <!-- Tag chips - compact, IBA / category tags from strTags -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/tagChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="0dp"
                    app:chipSpacingHorizontal="4dp"
                    app:singleLine="true"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>