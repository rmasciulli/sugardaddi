<?xml version="1.0" encoding="utf-8"?>
<!--
    detail_fatsecret_recipe.xml - Layout inflated by FatSecretRecipeDetailRenderer.

    Identical to detail_default_recipe.xml in every section except two
    FatSecret-specific additions, both backed by real source data with no
    existing display slot anywhere else in the app:
      - Star rating row (header card) - FatSecret's own "rating" field
        (1-5, detail-only; FatSecret provides no rating_count).
      - Categories card - recipe_types (small, curated) + recipe_categories
        (rich, detail-only) as chips, reusing chip_tag_compact.xml exactly
        as MealDB/CocktailDB's search cards already do.

    CONTENT:
      - Header card: name, cuisine, difficulty, prep/cook time, servings, rating
      - Categories card: tag chips (GONE when no tags)
      - Ingredients card: FoodPortion list (resolved or stub)
      - Instructions card: structured steps (RecipeStep list) or plain text fallback
      - Nutrition card: shown only when hasNutritionData() returns true
      - Notes card: shown only when notes are present
      - Attribution card

    All sections are GONE by default and shown only when data is available.
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- ================================================= -->
        <!-- HERO IMAGE - GONE when no image resolves           -->
        <!-- ================================================= -->
        <FrameLayout
            android:id="@+id/heroImageContainer"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/heroImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/recipe_image_content_description"
                android:scaleType="centerCrop" />

            <!-- Expand affordance: tap the hero to open it full-screen. Shown only when
                 the image is openable (toggled by ImageDisplayUtils.bindFullScreenTap). -->
            <ImageView
                android:id="@+id/heroExpandIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:background="@drawable/bg_expand_icon_scrim"
                android:padding="7dp"
                android:src="@drawable/ic_fullscreen"
                android:scaleType="fitCenter"
                android:visibility="gone"
                android:importantForAccessibility="no" />

        </FrameLayout>

        <!-- ================================================= -->
        <!-- HEADER CARD: name, metadata, rating                -->
        <!-- ================================================= -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/headerCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            app:cardElevation="1dp"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/recipeName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="Thick Chocolate Milkshake" />

                <TextView
                    android:id="@+id/recipeCuisine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone"
                    tools:text="American"
                    tools:visibility="visible" />

                <!-- Star rating: FatSecret's own 1-5 rating, detail-only.
                     Five fixed ImageViews (filled or outline per star), no
                     count alongside them - FatSecret provides no
                     rating_count, and showing "(0 ratings)" or omitting a
                     count next to a number that looks like an average would
                     both misrepresent what the source actually gives us.
                     The whole row is GONE when rating is 0/absent. -->
                <LinearLayout
                    android:id="@+id/ratingRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView android:id="@+id/ratingStar1"
                        android:layout_width="16dp" android:layout_height="16dp"
                        android:layout_marginEnd="2dp"
                        android:src="@drawable/ic_star_filled"
                        android:contentDescription="@null" />
                    <ImageView android:id="@+id/ratingStar2"
                        android:layout_width="16dp" android:layout_height="16dp"
                        android:layout_marginEnd="2dp"
                        android:src="@drawable/ic_star_filled"
                        android:contentDescription="@null" />
                    <ImageView android:id="@+id/ratingStar3"
                        android:layout_width="16dp" android:layout_height="16dp"
                        android:layout_marginEnd="2dp"
                        android:src="@drawable/ic_star_filled"
                        android:contentDescription="@null" />
                    <ImageView android:id="@+id/ratingStar4"
                        android:layout_width="16dp" android:layout_height="16dp"
                        android:layout_marginEnd="2dp"
                        android:src="@drawable/ic_star_outline"
                        android:contentDescription="@null" />
                    <ImageView android:id="@+id/ratingStar5"
                        android:layout_width="16dp" android:layout_height="16dp"
                        android:src="@drawable/ic_star_outline"
                        android:contentDescription="@null" />

                </LinearLayout>

                <!-- Metadata row: difficulty · time · servings -->
                <LinearLayout
                    android:id="@+id/metadataRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/recipeDifficulty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="Medium" />

                    <TextView
                        android:id="@+id/metadataSeparator1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:text="·"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/recipeTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone"
                        tools:text="35 min"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/metadataSeparator2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:text="·"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/recipeServings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone"
                        tools:text="1 serving"
                        tools:visibility="visible" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ================================================= -->
        <!-- CATEGORIES CARD - tag chips, GONE when none        -->
        <!-- recipe_types + recipe_categories, reusing the same -->
        <!-- chip_tag_compact.xml MealDB/CocktailDB's search    -->
        <!-- cards already use.                                 -->
        <!-- ================================================= -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/categoriesCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardElevation="1dp"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/recipe_section_categories"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="10dp" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/categoriesChipGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="6dp"
                    app:chipSpacingVertical="6dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ================================================= -->
        <!-- INGREDIENTS CARD                                  -->
        <!-- ================================================= -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/ingredientsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardElevation="1dp"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/recipe_section_ingredients"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:id="@+id/ingredientsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ================================================= -->
        <!-- INSTRUCTIONS CARD                                 -->
        <!-- ================================================= -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/instructionsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardElevation="1dp"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/recipe_section_instructions"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="12dp" />

                <!-- Steps are added programmatically -->
                <LinearLayout
                    android:id="@+id/stepsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ================================================= -->
        <!-- NOTES CARD                                        -->
        <!-- ================================================= -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/notesCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardElevation="1dp"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/recipe_section_notes"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/notesText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.5"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="Good for Phase 1 South Beach." />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ================================================= -->
        <!-- NUTRITION CARD                                     -->
        <!-- Shown only when hasNutritionData() is true         -->
        <!-- ================================================= -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/nutritionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardElevation="1dp"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/nutrition_facts"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="12dp" />

                <!-- Custom amount input - same widget/style as detail_default_recipe.xml. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_nutrition_block"
                    android:padding="1dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/customAmountInputLayout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/custom_amount_default"
                        app:boxBackgroundColor="?attr/colorSurface"
                        app:boxStrokeColor="@android:color/transparent"
                        app:boxStrokeWidthFocused="0dp"
                        app:boxCornerRadiusTopStart="7dp"
                        app:boxCornerRadiusTopEnd="7dp"
                        app:boxCornerRadiusBottomStart="7dp"
                        app:boxCornerRadiusBottomEnd="7dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/customAmountEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/colorSurface"
                            android:inputType="numberDecimal"
                            android:maxLines="1"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_nutrition_block"
                    android:padding="1dp">

                    <LinearLayout
                        android:id="@+id/nutritionContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="?attr/colorSurface" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ================================================= -->
        <!-- NO NUTRITION PLACEHOLDER                          -->
        <!-- ================================================= -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/noNutritionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardElevation="1dp"
            app:cardCornerRadius="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="@string/recipe_no_nutrition_data"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </com.google.android.material.card.MaterialCardView>

        <!-- ================================================= -->
        <!-- ATTRIBUTION CARD (amber, tappable → website)      -->
        <!-- ================================================= -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/attributionPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="?attr/colorAttributionCardAmberContainer"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:strokeColor="?attr/colorAttributionCardAmber">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/attributionSourceName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorOnAttributionCardAmberContainer"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/attributionLegalText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnAttributionCardAmberContainer"
                    android:textStyle="italic" />

                <TextView
                    android:id="@+id/attributionSourceDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnAttributionCardAmberContainer" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="end"
                    android:text="@string/label_visit_website"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorPrimary" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>