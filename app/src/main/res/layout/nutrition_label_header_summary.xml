<?xml version="1.0" encoding="utf-8"?>
<!--
    nutrition_label_header_summary.xml — Column header for SUMMARY mode (2 columns).

    TYPOGRAPHY: same as detailed header — textAppearanceLabelMedium (12sp medium).
    DARK MODE: ?attr/colorSurface background, ?attr/colorOnSurface text.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- Column headers row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <!-- Column 1: Nutrient name header -->
        <TextView
            android:id="@+id/headerNutrient"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold"
            android:paddingEnd="8dp"
            android:text="@string/nutrition_label_nutrient_column" />

        <!-- Column 2: Total / per-serving amount -->
        <TextView
            android:id="@+id/headerTotal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold"
            android:gravity="end"
            android:text="@string/nutrition_label_summary" />

    </LinearLayout>

    <!-- Separator line: same visual weight as detailed header -->
    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOnSurface" />

</LinearLayout>