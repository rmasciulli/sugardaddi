<?xml version="1.0" encoding="utf-8"?>
<!--
    nutrition_label_category_header.xml — Section divider between nutrient categories
    (e.g. "Macronutrients", "Vitamins", "Minerals").

    TYPOGRAPHY:
      textAppearanceLabelMedium (12sp medium) + italic.
      Category headers label a group — they should be the same size or smaller
      than top-level nutrient names (14sp BodyMedium), never larger.

    DARK MODE:
      Background ?attr/colorSurface. Text ?attr/colorPrimary (brand blue, works on
      both light and dark surfaces). Divider ?attr/colorPrimary at 40% alpha.

    SPACING:
      paddingTop="20dp" creates visual breathing room between categories.
      For the FIRST category header use nutrition_label_category_header_first.xml
      which has tighter top padding (10dp) to sit close to the table header.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <TextView
        android:id="@+id/categoryHeaderText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="?attr/colorPrimary"
        android:textStyle="italic"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="20dp"
        android:paddingBottom="6dp"
        android:gravity="start|center_vertical"
        android:text="@string/nutrition_category_macronutrients" />

    <!-- Thin primary-color line visually connects the header to its nutrient group -->
    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:background="?attr/colorPrimary"
        android:alpha="0.4" />

</LinearLayout>