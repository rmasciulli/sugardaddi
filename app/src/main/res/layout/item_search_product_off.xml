<?xml version="1.0" encoding="utf-8"?>
<!--
    item_search_product_off.xml
    Search result card for OpenFoodFacts products.

    STRUCTURE:
    [Product name (bold, 1 line max)]          [OFF badge]
    Food product                               <- productType subtitle
    [72x72 image]  Brand (primary)             [leaf 32dp    ]
                   Category (2 lines)          [NUTRISCORE   ]
                   200 g (italic)

    SCORE STACK (vertical LinearLayout, gravity=center_horizontal):
    - Both leaf and nutriscore sticker are centered on the same axis.
    - Works because ScoreOverlayHelper.createNutriScoreTplWithText sets
      imageParams.gravity = Gravity.CENTER_HORIZONTAL on the sticker ImageView.
    - No FrameLayout tricks, no match_parent hacks needed.

    Used by: OffProductSearchDelegate
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- ROW 1: product name + source badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">

            <TextView
                android:id="@+id/mealQuantityBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSecondaryContainer"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="231g - " />

            <TextView
                android:id="@+id/productName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Belvita Petit-Dejeuner Miel et Pepites de Chocolat" />

            <TextView
                android:id="@+id/sourceBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorSecondary"
                android:background="@drawable/rounded_corner_8dp"
                android:backgroundTint="?attr/colorPrimary"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="OFF" />

            <ImageView
                android:id="@+id/navigateChevron"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:padding="2dp"
                android:src="@drawable/ic_chevron_right"
                android:contentDescription="@string/view_details"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

        <!-- ROW 2: productType subtitle ("Food product") -->
        <TextView
            android:id="@+id/productType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="Food product" />

        <!-- ROW 3: image | details | scores. Plain LinearLayout, matching
             the other three product cards exactly - the ConstraintLayout
             version of this row went through two failed attempts for
             reasons never fully explained; this mechanism is proven
             working elsewhere in this exact refactor. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <include layout="@layout/thumbnail_72dp" />

            <!-- Details column: fills remaining width AND stretches to match
                 the thumbnail's height (match_parent) - the Space below needs
                 real height to absorb. See item_search_product_default.xml
                 for the full rationale. -->
            <LinearLayout
                android:id="@+id/detailsColumn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="72dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/brandName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:fontFamily="@font/inter"
                    android:fontWeight="600"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorPrimary"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:text="Mondelez International" />

                <TextView
                    android:id="@+id/categories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:fontFamily="@font/roboto_condensed"
                    android:fontWeight="300"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:text="Dark chocolate bar with more than 70 cocoa" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginBottom="2dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/servingInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_condensed"
                    android:textStyle="italic"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:text="285 g" />

            </LinearLayout>

            <!-- SCORE STACK: now a plain LinearLayout sibling, vertically
                 centered in the row via layout_gravity instead of
                 ConstraintLayout's dual top+bottom pin. Internal
                 gravity=center_horizontal (leaf+nutriscore on the same
                 axis) is unchanged. -->
            <LinearLayout
                android:id="@+id/scoreContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/greenScoreLeaf"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginBottom="10dp"
                    android:contentDescription="@string/content_description_green_score"
                    android:scaleType="fitCenter"
                    tools:src="@drawable/greenscore_leaf_a_plus" />

                <FrameLayout
                    android:id="@+id/nutriScoreContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

        </LinearLayout>
        <include layout="@layout/expandable_nutrition_detail" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>