<?xml version="1.0" encoding="utf-8"?>
<!--
    nutrition_label_row_indented.xml - Indented nutrient row (indent level 1).
    Examples: "of which saturated", "of which sugars".

    TYPOGRAPHY:
      Nutrient name: textAppearanceBodySmall (12sp regular) - visually subordinate
      to level-0 rows. colorOnSurfaceVariant signals secondary content.
      Values: autoSize 11-13sp.

    INDENTATION: paddingStart="16dp" on the name TextView pushes it right.

    DARK MODE: ?attr/colorSurface background, divider at 10% alpha.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:gravity="center_vertical"
        android:minHeight="32dp">

        <!-- Column 1: Nutrient name - 16dp indent signals sub-nutrient -->
        <TextView
            android:id="@+id/nutrientName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:text="  of which saturated" />

        <!-- Column 2: Per 100g value -->
        <TextView
            android:id="@+id/valuePer100g"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="11sp"
            android:autoSizeMaxTextSize="13sp"
            android:autoSizeStepGranularity="1sp"
            android:gravity="end"
            android:paddingEnd="8dp"
            android:text="0 g" />

        <!-- Column 3: Custom amount value -->
        <TextView
            android:id="@+id/valueCustomAmount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="11sp"
            android:autoSizeMaxTextSize="13sp"
            android:autoSizeStepGranularity="1sp"
            android:gravity="end"
            android:text="0 g" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="8dp"
        android:background="?attr/colorOnSurface"
        android:alpha="0.1" />

</LinearLayout>