<?xml version="1.0" encoding="utf-8"?>
<!--
    nutrition_label_row_indented.xml - Indented nutrient row (indent level 1), e.g. "Sugars", "Saturated fat".

    STRUCTURE (the same in the three row layouts):
      rowContent (FrameLayout)
        nameScroll: the name on ONE line, as wide as the whole row. A long name
          runs under the value columns and is read by dragging it sideways
          (HorizontalScrollView, one per row).
        valueBlock (on top, end of the row): the fade, then valueColumns (the
          table background, opaque) with the per-100 column and the custom
          amount column.
          - valueFade: shown only when the name is long enough to run under the
            values (NutritionLabelManager.fitRow); 16dp from transparent to the
            table background, so the name fades out instead of being cut.
          - Column widths are set by NutritionLabelManager from the widest value
            and title of the table (no wrapping, no auto-size); the gap between
            the two columns is @dimen/nutrition_column_gap.
      divider
    Touches on the values fall through to the name scroller (the value block is
    not clickable), so the whole row can be dragged.

    TEXT (res/values/nutrition_text.xml): Sub role (13sp). Name and per-100 value in
    colorOnSurfaceVariant (second grey shade). 16dp indent.
    Custom amount column in ?attr/colorPrimary at every level: it is the amount
    being logged, told apart from the per-100 column at a glance.

    DARK MODE: valueColumns and the fade use the table's fill
    (colorSurfaceContainerLowest, as bg_nutrition_block).
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/rowContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:minHeight="32dp">

        <HorizontalScrollView
            android:id="@+id/nameScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:overScrollMode="never"
            android:scrollbars="none">

            <TextView
                android:id="@+id/nutrientName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:paddingStart="16dp"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.SugarDaddi.Nutrition.Sub"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:text="Nutrient" />

        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/valueBlock"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:orientation="horizontal">

            <!-- Gradient set in code (NutritionLabelManager.nameFadeDrawable) -->
            <View
                android:id="@+id/valueFade"
                android:layout_width="@dimen/nutrition_name_fade"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <!-- Opaque behind both columns and the gap between them -->
            <LinearLayout
                android:id="@+id/valueColumns"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="?attr/colorSurfaceContainerLowest"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/valuePer100g"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.SugarDaddi.Nutrition.Sub"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:text="0 g" />

                <TextView
                    android:id="@+id/valueCustomAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/nutrition_column_gap"
                    android:gravity="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.SugarDaddi.Nutrition.Sub"
                    android:textColor="?attr/colorPrimary"
                    android:text="0 g" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

    <!-- Row divider - light separator, not a strong line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="8dp"
        android:background="?attr/colorOnSurface"
        android:alpha="0.1" />

</LinearLayout>
