<?xml version="1.0" encoding="utf-8"?>
<!--
    detail_usda_product.xml - Detail layout for USDA FoodData Central products.

    CARD STRUCTURE (mirrors detail_ciqual_product.xml):
      1. Main content card:
           a. Product info: name, category, serving size, quick nutrition summary
           b. Nutrition Facts section (NutritionLabelManager, DETAILED mode)
      2. Attribution card (amber, separate, tappable → fdc.nal.usda.gov)

    Hero image shown only when user sets one via ImagePickerHelper (no remote source image).
    No scores, no allergens - same constraints as Ciqual.
    USDA FoodData Central is a US government public-domain scientific database.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="80dp"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 1. HERO IMAGE (optional, GONE when no user-defined image available) -->
        <!-- USDA has no remote image URL - shown only when set via ImagePickerHelper. -->
        <FrameLayout
            android:id="@+id/heroImageContainer"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/heroImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/product_image_description"
                android:scaleType="centerCrop" />

            <!-- Expand affordance: tap the hero to open it full-screen. Shown only when
                 the image is openable (toggled by ImageDisplayUtils.bindFullScreenTap). -->
            <ImageView
                android:id="@+id/heroExpandIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="8dp"
                android:background="@drawable/bg_expand_icon_scrim"
                android:padding="7dp"
                android:src="@drawable/ic_fullscreen"
                android:scaleType="fitCenter"
                android:visibility="gone"
                android:importantForAccessibility="no" />

        </FrameLayout>

        <!-- 2. MAIN CONTENT CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- a. Product info -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:id="@+id/productName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="3"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold"
                        tools:text="Broccoli, raw" />

                    <!-- USDA food category, e.g. "Vegetables and Vegetable Products" -->
                    <TextView
                        android:id="@+id/categoryText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone"
                        tools:text="Vegetables and Vegetable Products"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/servingSizeText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone"
                        tools:text="Serving size: 148g"
                        tools:visibility="visible" />

                    <!-- Quick nutrition summary: carbs left, kcal right -->
                    <LinearLayout
                        android:id="@+id/nutritionSummaryRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="4dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:id="@+id/nutritionSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/roboto_condensed"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:maxLines="1"
                            android:ellipsize="end"
                            tools:text="6.6g carbohydrates per 100g" />

                        <TextView
                            android:id="@+id/kcalBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:paddingHorizontal="8dp"
                            android:fontFamily="@font/inter"
                            android:fontWeight="500"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:textColor="?attr/colorPrimary"
                            tools:text="67 kcal" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Divider between product info and nutrition facts -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:background="?attr/colorOutlineVariant" />

                <!-- b. Nutrition Facts section - managed by NutritionLabelManager -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/nutrition_facts"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:letterSpacing="0.05" />

                    <!-- Custom amount input -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_nutrition_block"
                        android:padding="1dp">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/customAmountInputLayout"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/custom_amount_default"
                            app:boxBackgroundColor="?attr/colorSurface"
                            app:boxStrokeColor="@android:color/transparent"
                            app:boxStrokeWidthFocused="0dp"
                            app:boxCornerRadiusTopStart="7dp"
                            app:boxCornerRadiusTopEnd="7dp"
                            app:boxCornerRadiusBottomStart="7dp"
                            app:boxCornerRadiusBottomEnd="7dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/customAmountEditText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="?attr/colorSurface"
                                android:inputType="numberDecimal"
                                android:maxLines="1"
                                android:paddingTop="8dp"
                                android:paddingBottom="8dp" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_nutrition_block"
                        android:padding="1dp">

                        <LinearLayout
                            android:id="@+id/nutritionContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="?attr/colorSurface" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 2. ATTRIBUTION CARD (amber, separate, tappable) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/attributionPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="?attr/colorAttributionCardAmberContainer"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:strokeColor="?attr/colorAttributionCardAmber">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/attributionSourceName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorOnAttributionCardAmberContainer"
                    android:textStyle="bold"
                    tools:text="🇺🇸 USDA FoodData" />

                <TextView
                    android:id="@+id/attributionLegalText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnAttributionCardAmberContainer"
                    android:textStyle="italic"
                    tools:text="U.S. Department of Agriculture, Agricultural Research Service. FoodData Central. fdc.nal.usda.gov" />

                <TextView
                    android:id="@+id/attributionSourceDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnAttributionCardAmberContainer"
                    tools:text="US Department of Agriculture food database" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="end"
                    android:text="@string/label_visit_website"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorPrimary" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>