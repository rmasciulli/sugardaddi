<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_quantity_input.xml - background of QuantityInputView.

    White rounded rectangle (near-black in dark mode), no border: same spirit
    as the confidence banner of the nutrition label (8dp corners, flat fill),
    standing out on the grey detail card.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="?attr/colorSurfaceContainerLowest" />

    <corners android:radius="8dp" />

</shape>
