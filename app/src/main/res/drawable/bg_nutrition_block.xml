<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_nutrition_block.xml - the bordered box shared by the nutrition table
    (NutritionLabelManager's subContainer) and the quantity input above it
    (QuantityInputView), so the two read as one family on the grey card.

    White fill (colorSurfaceContainerLowest, theme attribute so dark mode
    follows), square corners, 1dp outlineVariant border. The table rows have
    no background of their own: this fill shows through them.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="?attr/colorSurfaceContainerLowest" />

    <stroke
        android:width="1dp"
        android:color="@color/md_theme_outlineVariant" />

</shape>