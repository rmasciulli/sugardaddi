    <!-- =====================================================================
         COMPONENT STYLES - declared here to avoid duplication with themes.xml
         These are referenced from both light and dark themes.
         ===================================================================== -->

    <style name="CardView.SugarDaddi" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardElevation">2dp</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="CardView.SugarDaddi.Elevated" parent="CardView.SugarDaddi">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
        <item name="cardElevation">4dp</item>
    </style>

    <style name="TextInputLayout.SugarDaddi"
        parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">?attr/colorSurfaceContainerHighest</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/md_theme_primary</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
    </style>

    <style name="Button.SugarDaddi" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/md_theme_primary</item>
        <item name="android:textColor">@color/md_theme_onPrimary</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Button.SugarDaddi.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/md_theme_primary</item>
        <item name="android:textColor">@color/md_theme_primary</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="FloatingActionButton.SugarDaddi"
        parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/md_theme_primaryContainer</item>
        <item name="tint">@color/md_theme_onPrimaryContainer</item>
    </style>

    <style name="TextAppearance.SugarDaddi.NutriScore"
        parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/nutri_score_text</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>