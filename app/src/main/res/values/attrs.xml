<resources>
    <!--
        Custom theme attributes for the Attribution Card amber extended color.
        Generated by Material Theme Builder alongside the main palette.
        Use ?attr/colorAttributionCardAmberContainer as the card background
        and ?attr/colorOnAttributionCardAmberContainer for text on top of it.
    -->
    <attr name="colorAttributionCardAmber" format="color" />
    <attr name="colorOnAttributionCardAmber" format="color" />
    <attr name="colorAttributionCardAmberContainer" format="color" />
    <attr name="colorOnAttributionCardAmberContainer" format="color" />
</resources>