<?xml version="1.0" encoding="utf-8"?>
<!--
    menu_product_details.xml — Toolbar menu for ProductDetailsActivity.
    ALWAYS VISIBLE:
      - Favourite : toggles border/filled star
    OVERFLOW (⋮):
      - Share
      - Open in browser   hidden when source has no website
      - Replace image     always shown (caller guards unavailable storage)
      - Replace thumbnail always shown
      - Remove image      hidden when userImagePath is null
      - Remove thumbnail  hidden when userThumbnailPath is null
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <!-- Favourite (toggles between border and filled) -->
    <item
        android:id="@+id/action_favorite"
        android:icon="@drawable/ic_favorite_rounded_border"
        android:title="@string/add_to_favorites"
        app:showAsAction="always"
        app:iconTint="@android:color/white" />

    <!-- ── Overflow items ──────────────────────────────────────────────── -->

    <!-- Share product info as plain text -->
    <item
        android:id="@+id/action_share"
        android:title="@string/menu_share"
        app:showAsAction="never" />

    <!--
        Open product page (e.g. OpenFoodFacts).
        Hidden when ProductUrlBuilder.hasWebsiteSupport() returns false.
    -->
    <item
        android:id="@+id/action_open_web"
        android:title="@string/menu_open_web"
        android:visible="false"
        app:showAsAction="never" />

    <!--
        Replace full-size image — always shown.
        Triggers camera/gallery picker → ImagePickerHelper → userImagePath.
    -->
    <item
        android:id="@+id/action_replace_image"
        android:title="@string/menu_replace_image"
        app:showAsAction="never" />

    <!--
        Replace thumbnail — always shown.
        Triggers camera/gallery picker → ImagePickerHelper → userThumbnailPath.
        Writes to thumbnails/{id}_custom.jpg (deterministic, co-exists with auto-cached).
    -->
    <item
        android:id="@+id/action_replace_thumbnail"
        android:title="@string/menu_replace_thumbnail"
        app:showAsAction="never" />

    <!--
        Remove user-defined full-size image.
        Hidden when userImagePath is null — shown in onPrepareOptionsMenu().
    -->
    <item
        android:id="@+id/action_remove_image"
        android:title="@string/menu_remove_image"
        android:visible="false"
        app:showAsAction="never" />

    <!--
        Remove user-defined thumbnail.
        Hidden when userThumbnailPath is null — shown in onPrepareOptionsMenu().
    -->
    <item
        android:id="@+id/action_remove_thumbnail"
        android:title="@string/menu_remove_thumbnail"
        android:visible="false"
        app:showAsAction="never" />

</menu>