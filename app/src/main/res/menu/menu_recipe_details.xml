<?xml version="1.0" encoding="utf-8"?>
<!--
    menu_recipe_details.xml — Toolbar menu for RecipeDetailsActivity.

    ITEMS:
      - Favourite : toggles border/filled star (all recipes)
      - Share     : share recipe name, source URL, and video link
      - Web       : open recipe page on TheMealDB / TheCocktailDB
                    hidden by default, shown in onPrepareOptionsMenu()
                    only when RecipeUrlBuilder.hasWebsiteSupport() returns true
      - Video     : open video URL in browser
                    hidden by default, shown only when recipe has videoUrl

    Now matches the structure of menu_item_details.xml used for food products.
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Favourite (toggles between border and filled star) -->
    <item
        android:id="@+id/action_favorite"
        android:icon="@drawable/ic_favorite_rounded_border"
        android:title="@string/add_to_favorites"
        app:showAsAction="always"
        app:iconTint="@android:color/white" />

    <!-- Share recipe name, source URL, and video link as plain text -->
    <item
        android:id="@+id/action_share"
        android:icon="@drawable/ic_share_rounded"
        android:title="@string/menu_share"
        app:showAsAction="always"
        app:iconTint="@android:color/white" />

    <!--
        Open recipe page on TheMealDB / TheCocktailDB.
        Hidden by default — shown in onPrepareOptionsMenu() only when
        RecipeUrlBuilder.hasWebsiteSupport(recipe.getSourceIdentifier()) is true.
        Not shown for USER recipes (no external page exists).
    -->
    <item
        android:id="@+id/action_open_web"
        android:icon="@drawable/ic_open_in_new_rounded"
        android:title="@string/menu_open_web"
        android:visible="false"
        app:showAsAction="always"
        app:iconTint="@android:color/white" />

    <!--
        Video link — hidden by default, shown in onPrepareOptionsMenu()
        only when recipe.getVideoUrl() is non-null.
    -->
    <item
        android:id="@+id/action_video"
        android:icon="@drawable/ic_play_circle"
        android:title="@string/menu_watch_video"
        android:visible="false"
        app:showAsAction="always"
        app:iconTint="@android:color/white" />

</menu>