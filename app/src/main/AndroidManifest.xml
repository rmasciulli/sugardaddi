<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Camera - required to launch ACTION_IMAGE_CAPTURE for meal/step photos.
     maxSdkVersion is not set: the permission is needed on all supported
     SDK versions (26+). -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Declares that the app can use a camera but does not strictly require one.
         Without required="false", devices without a camera will be filtered out
         of the Play Store entirely, which is too restrictive for a nutrition app. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".SugarDaddiApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SugarDaddi">

        <!-- Main Activity (Launcher) -->
        <activity
            android:name=".ui.activities.MainActivity"
            android:exported="true"
            android:label="@string/main_activity_title"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SugarDaddi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Journal Activity -->
        <activity
            android:name=".ui.activities.JournalActivity"
            android:exported="false"
            android:label="@string/journal_title"
            android:parentActivityName=".ui.activities.MainActivity"
            android:theme="@style/Theme.SugarDaddi" />

        <!-- Meal Details Activity -->
        <activity
            android:name=".ui.activities.MealDetailsActivity"
            android:exported="false"
            android:label="@string/meal_details_title"
            android:parentActivityName=".ui.activities.JournalActivity"
            android:theme="@style/Theme.SugarDaddi" />

        <!-- Create Meal Activity -->
        <activity
            android:name=".ui.activities.CreateMealActivity"
            android:exported="false"
            android:label="@string/create_meal_title"
            android:parentActivityName=".ui.activities.JournalActivity"
            android:theme="@style/Theme.SugarDaddi" />

        <!-- Product Details Activity -->
        <activity
            android:name=".ui.activities.ProductDetailsActivity"
            android:exported="false"
            android:label="@string/product_details_title"
            android:parentActivityName=".ui.activities.MainActivity"
            android:theme="@style/Theme.SugarDaddi" />

        <!-- Recipe Details Activity -->
        <activity
            android:name=".ui.activities.RecipeDetailsActivity"
            android:exported="false"
            android:label="@string/recipe_details_title"
            android:parentActivityName=".ui.activities.MainActivity"
            android:theme="@style/Theme.SugarDaddi" />

        <!-- Barcode Scanner Activity -->
        <activity
            android:name=".ui.activities.BarcodeScannerActivity"
            android:exported="false"
            android:label="@string/scan_product"
            android:parentActivityName=".ui.activities.MainActivity"
            android:theme="@style/Theme.SugarDaddi" />

        <!-- uCrop - required for the image crop step in ImagePickerHelper -->
        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:screenOrientation="unspecified"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />

        <!-- Data Sources Activity -->
        <activity
            android:name=".ui.activities.DataSourcesActivity"
            android:exported="false"
            android:label="@string/data_sources_title"
            android:parentActivityName=".ui.activities.SettingsActivity"
            android:theme="@style/Theme.SugarDaddi" />

        <!-- Settings Activity -->
        <activity
            android:name=".ui.activities.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:parentActivityName=".ui.activities.MainActivity"
            android:theme="@style/Theme.SugarDaddi" />

        <!-- Favorites Activity -->
        <activity
            android:name=".ui.activities.FavoritesActivity"
            android:exported="false"
            android:label="@string/menu_favorites"
            android:parentActivityName=".ui.activities.MainActivity" />

        <!-- Import Service -->
        <!-- Reads bundled assets and imports into Room. foregroundServiceType=dataSync -->
        <!-- required for startForegroundService() on API 34+ -->
        <service
            android:name=".data.sources.ciqual.CiqualImportService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".data.sources.usda.USDAImportService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- FileProvider - required to share file:// URIs with the camera app
             on API 24+. Without this, the camera intent throws a FileUriExposedException.

             authorities: must match ImagePickerHelper.FILE_PROVIDER_AUTHORITY exactly.
             exported="false": the provider is not accessible to other apps directly.
             grantUriPermissions="true": allows temporary read/write access to the
               URI granted via the camera intent's FLAG_GRANT_WRITE_URI_PERMISSION.
             resource: points to res/xml/file_paths.xml which declares the
               subdirectories this provider is allowed to serve. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="li.masciul.sugardaddi.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>